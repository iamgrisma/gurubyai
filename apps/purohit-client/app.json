{
  "expo": {
    "name": "Purohit",
    "slug": "purohit",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "purohit",
    "ios": {
      "bundleIdentifier": "com.purohit.app"
    },
    "android": {
      "package": "com.purohit.app"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Purohit uses your location only when you choose to set a service visit location."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
