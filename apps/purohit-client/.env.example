# CI / SERVER-ONLY SECRETS — never prefix these with EXPO_PUBLIC_:
# GitHub Actions: add as repository/environment secrets.
SUPABASE_DB_URL=postgresql://postgres:<password>@<db-host>:5432/postgres
EXPO_TOKEN=<Expo/EAS access token>

# Supabase Edge Functions / local privileged operations:
# Never put this in the Expo app or browser bundle.
SUPABASE_SERVICE_ROLE_KEY=<Supabase service-role key>

# Notes:
# - EXPO_PUBLIC_SUPABASE_ANON_KEY is intentionally client-visible; authorization is enforced by Supabase RLS/RPCs.
# - SUPABASE_DB_URL, EXPO_TOKEN, and SUPABASE_SERVICE_ROLE_KEY are sensitive.
# - Current repo workflows consume SUPABASE_DB_URL and EXPO_TOKEN.
# - The job-worker Edge Function consumes SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from its server-side environment.